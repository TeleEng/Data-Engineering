# ============================================================
# Environment Configuration
# ============================================================
# Tickers to track (comma-separated)
STOCK_TICKERS=AAPL,MSFT,GOOGL,AMZN,TSLA

# How often the producer fetches prices (in seconds)
FETCH_INTERVAL_SECONDS=10

# Kafka Configuration
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=stock-prices

# Ports (change if conflicts)
PORTAINER_PORT=9000
KAFKA_UI_PORT=8080
